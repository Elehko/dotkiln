<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageProjectUrl>https://github.com/dotkiln/dotkiln</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dotkiln/dotkiln</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Authors>Dotkiln contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>A package stack manager and safe update engine for .NET. Dotkiln helps developers define, reuse, apply, check, and safely update curated NuGet package stacks.</Description>
    <PackageIcon>Dotkiln Icon.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)docs\assets\Dotkiln Icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
